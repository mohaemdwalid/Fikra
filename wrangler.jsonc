{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fikra",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-10-15",
  "send_email": [{"name": "LEAD_ALERT_EMAIL"}],
  "vars": {"LEAD_ALERT_EMAIL_FROM": "leads@fikra-agency.com"},
  "triggers": {"crons": ["*/5 * * * *"]},
  "assets": {
    "directory": "./cloudflare-upload",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [{
    "binding": "LEADS_DB",
    "database_name": "fikra-leads",
    "database_id": "84271bb8-50a9-4a00-9aae-64b1c504f914",
    "migrations_dir": "migrations"
  }]
}
